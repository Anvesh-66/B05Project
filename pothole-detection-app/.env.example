# Model Configuration
# POTHOLE_MODEL_PATH=models/pothole/best.pt
# POTHOLE_DATA_DIR=var/
# POTHOLE_DEVICE=cpu
# POTHOLE_CONF=0.25
# POTHOLE_IOU=0.45
# POTHOLE_CLASS_NAME=pothole

# Authentication
# POTHOLE_SECRET_KEY=your-secret-key-here

# Email Notifications (Optional)
# Configure these to enable email notifications for report submissions and status updates
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM_EMAIL=noreply@potholedetection.com
# SMTP_FROM_NAME=Pothole Detection System

# Weather Integration (Optional)
# Get free API key from: https://openweathermap.org/api
# WEATHER_API_KEY=your-openweathermap-api-key

# Geocoding
# POTHOLE_GEOCODE=1

# Depth Estimation
# POTHOLE_DEPTH_MODEL=models/depth
# POTHOLE_DEPTH_NEUTRAL=0.04
# POTHOLE_DEPTH_SEVERE=0.10

# Note: For Gmail, you need to use an App Password, not your regular password
# Generate one at: https://myaccount.google.com/apppasswords

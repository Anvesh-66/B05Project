# Address of the FastAPI backend (pothole-detection-app).
# Copy this file to .env.local to change it. It is read when the app is built or started in dev mode.
BACKEND_URL=http://127.0.0.1:8000

# Email Configuration (Optional)
# Configure these to enable email notifications from the admin panel
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM_EMAIL=admin@potholedetection.com
# SMTP_FROM_NAME=Pothole Admin Panel

